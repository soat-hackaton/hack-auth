# ==========================================
# Configurações da Aplicação (Auth Service)
# ==========================================

# Porta onde o servidor vai rodar (Default: 8080)
PORT=8080

# Modo do Gin: "debug" (logs detalhados) ou "release" (produção)
GIN_MODE=debug

# ==========================================
# Segurança (JWT)
# ==========================================

# Chave secreta para assinar e validar tokens.
# IMPORTANTE: Essa mesma chave deverá ser configurada no plugin JWT do Kong.
JWT_SECRET=sua_chave_secreta_aqui_change_me

# ==========================================
# AWS & DynamoDB
# ==========================================

# Região da AWS (Geralmente us-west-2 no AWS Academy)
AWS_REGION=us-west-2

# Nome da tabela do DynamoDB (Deve ser o mesmo definido no Terraform)
DYNAMO_TABLE_NAME=hack-users-auth

# ==========================================
# Credenciais AWS (AWS Academy)
# ==========================================
# Como o AWS Academy usa credenciais temporárias, você precisa preencher
# os 3 campos abaixo sempre que iniciar uma nova sessão (a cada 4h).
# Deixe em branco se estiver rodando no EKS (lá ele usa IAM Role).

AWS_ACCESS_KEY_ID=aws_access_key_id
AWS_SECRET_ACCESS_KEY=aws_secret_access_key
AWS_SESSION_TOKEN=aws_session_token